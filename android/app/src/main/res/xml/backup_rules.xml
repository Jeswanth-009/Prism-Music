<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Exclude private app database and hive storage from cloud backups -->
    <exclude domain="file" path="app_flutter" />
    <exclude domain="root" path="cache" />
    <exclude domain="external" path="Downloads" />
    <exclude domain="sharedpref" path="FlutterSecureStorage" />
</full-backup-content>
