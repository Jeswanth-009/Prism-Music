<?xml version="1.0" encoding="utf-8"?>
<!-- Remote providers are reached over HTTPS, so cleartext stays denied globally.

     DLNA / UPnP casting is NOT governed by this policy: the Android network
     security config only applies to platform stacks (HttpURLConnection, OkHttp,
     WebView, ExoPlayer). CastService sends its SSDP and SOAP traffic through
     dart:io sockets, which Android does not police at socket level. Loosening
     this file would therefore not enable any LAN casting, it would only permit
     plaintext to arbitrary hosts.

     Keep cleartext limited to loopback, where a local proxy or developer tooling
     may legitimately speak HTTP. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
